{
  "name": "arkpedia-desktop-chibis-dev",
  "productName": "Arkpedia Chibis Dev",
  "version": "0.2.0",
  "private": true,
  "description": "Arkpedia desktop chibis: Arknights chibis walking on your desktop",
  "author": "Arkpedia",
  "main": "electron/main.cjs",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "start": "electron .",
    "test": "node --test \"tests/*.test.*\"",
    "package:mac": "npm run build && electron-builder --mac dmg zip --arm64 --x64 --publish never",
    "package:win": "npm run build && electron-builder --win nsis zip --x64 --arm64 --publish never",
    "package:linux": "npm run build && electron-builder --linux AppImage deb --x64 --arm64 --publish never"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "vite": "8.3.4",
    "typescript": "^5.9.3",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@types/node": "^24.0.0"
  },
  "build": {
    "appId": "net.arkpedia.chibis.dev",
    "productName": "Arkpedia Chibis Dev",
    "directories": {
      "output": "releases"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.entertainment",
      "identity": null,
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "signAndEditExecutable": false,
      "target": [
        "nsis",
        "zip"
      ]
    },
    "artifactName": "Arkpedia-Chibis-Dev-${os}-${arch}.${ext}",
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Game",
      "maintainer": "Arkpedia",
      "synopsis": "Arknights chibis walking on your desktop"
    }
  },
  "license": "UNLICENSED",
  "homepage": "https://github.com/arkpedia/arkpedia-desktop-chibis"
}
