{
  "name": "arkpedia-desktop-chibis-dev",
  "productName": "Arkpedia Chibis Dev",
  "version": "0.1.0",
  "private": true,
  "description": "Separate Arkpedia desktop companion development preview",
  "author": "Arkpedia",
  "main": "electron/main.cjs",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "start": "electron .",
    "package:mac": "npm run build && electron-builder --mac zip --arm64 --publish never",
    "package:win": "npm run build && electron-builder --win zip --x64 --publish never"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "vite": "8.3.4",
    "typescript": "^5.9.3",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@types/node": "^24.0.0"
  },
  "build": {
    "appId": "net.arkpedia.chibis.dev",
    "productName": "Arkpedia Chibis Dev",
    "directories": {
      "output": "releases"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.entertainment",
      "identity": null
    },
    "win": {
      "signAndEditExecutable": false
    },
    "artifactName": "Arkpedia-Chibis-Dev-${version}-${os}-${arch}.${ext}"
  }
}
